model StageHistory {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type     HistoryEntityType
  entity_id       String            @db.Uuid
  from_stage      String?
  to_stage        String
  changed_by      String            @db.Uuid
  changed_by_user User              @relation(fields: [changed_by], references: [id])
  reason          String?
  changed_at      DateTime          @default(now())

  // Multi-company ERP (Phase 0) — nullable until Phase 1, see Org model comment.
  // entity_id is polymorphic (no FK), so org_id is set directly here rather
  // than derived by a join — lets profitability/reporting filter by org
  // without resolving entity_type first.
  org_id String? @db.Uuid
  org    Org?    @relation(fields: [org_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([org_id])
  @@map("stage_history")
}

// Append-only trail for superadmin record deletion / restore. `snapshot` holds the
// full row pre-image so a delete can be reviewed or reversed even without a DB dump.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String   @db.Uuid
  action      String // 'soft_delete' | 'restore'
  entity_type String
  entity_id   String   @db.Uuid
  reason      String
  snapshot    Json
  created_at  DateTime @default(now())

  // Multi-company ERP (Phase 0) — nullable until Phase 1, see Org model comment.
  org_id String? @db.Uuid
  org    Org?    @relation(fields: [org_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([actor_id])
  @@index([org_id])
  @@map("audit_logs")
}

