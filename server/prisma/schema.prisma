  @@index([source])
  @@index([added_by])
  @@index([is_active])
  @@index([source, on_bench])
  @@index([deleted_at])
  @@index([org_id])
  @@map("profiles")
}

model Submission {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requirement_seat_id String          @db.Uuid
  seat                RequirementSeat @relation(fields: [requirement_seat_id], references: [id], onDelete: Cascade)
  profile_id          String          @db.Uuid
  profile             Profile         @relation(fields: [profile_id], references: [id])
