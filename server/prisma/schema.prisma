  expected_ctc_currency ProfileCurrency @default(INR)
  ctc_negotiable        Boolean         @default(false)
  ctc_notes             String?
  notice_period_days    Int?
  is_serving_notice     Boolean         @default(false)
  last_working_day      DateTime?       @db.Date
  earliest_join_date    DateTime?       @db.Date
  preferred_work_mode   WorkMode?

  resume_url      String?
  linkedin_url    String?
  portfolio_url   String?
  other_documents Json    @default("[]")

  source            ProfileSource
  vendor_account_id String?       @db.Uuid
  vendor_account    Account?      @relation("ProfileVendorAccount", fields: [vendor_account_id], references: [id])
  vendor_profile_id String?
  added_by          String        @db.Uuid
  added_by_user     User          @relation("ProfileAddedBy", fields: [added_by], references: [id])
  recruiter_notes   String?

  on_bench   Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  // Superadmin soft-delete (see AuditLog + the $use filter in config/db.js).
  deleted_at    DateTime?
  deleted_by    String?   @db.Uuid
