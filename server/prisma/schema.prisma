  org    Org?    @relation(fields: [org_id], references: [id])

  interview_rounds InterviewRound[]

  @@index([requirement_seat_id])
  @@index([profile_id])
  @@index([stage])
  @@index([deleted_at])
  @@index([org_id])
  @@map("submissions")
}

model InterviewRound {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id     String      @db.Uuid
  submission        Submission  @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  round_number      Int
  round_type        RoundType
  round_name        String?
  scheduled_at      DateTime?
  duration_minutes  Int?
  interviewer_name  String?
  interviewer_email String?
  meeting_link      String?
  result            RoundResult @default(pending)
  feedback          String?
  rating            Int?
  completed_at      DateTime?

  status                  InterviewRoundStatus @default(scheduled)
  cancelled_at            DateTime?
  cancellation_reason     String?
  reminder_sent_at        DateTime?
  reminder_1h_sent_at     DateTime?
  online_meeting_provider String?
  external_event_id       String?

  scheduled_by String? @db.Uuid
  scheduler    User?   @relation("InterviewRoundScheduler", fields: [scheduled_by], references: [id], onDelete: SetNull)

  // Superadmin soft-delete (see AuditLog + the $use filter in config/db.js).
  deleted_at    DateTime?
  deleted_by    String?   @db.Uuid
  delete_reason String?

  // Multi-company ERP (Phase 0) — nullable until Phase 1, see Org model comment.
