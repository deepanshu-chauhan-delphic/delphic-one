NODE_ENV=development
PORT=4000
# debug|info|warn|error — see docs/BACKEND-LOGGING.md
LOG_LEVEL=debug

DATABASE_URL=postgres://postgres:postgres@localhost:5432/requirement_dashboard
# Prisma pool. Append ?connection_limit=N&pool_timeout=20 to DATABASE_URL in
# real deployments (docker-compose sets DB_CONNECTION_LIMIT, default 15). Size it
# to Postgres max_connections divided by the number of API workers.

# Generate with: openssl rand -hex 32
# Production refuses missing, short (<32), or placeholder secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Public SPA origin. Production must not be localhost.
CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
