# docker-compose environment overrides — copy to .env and adjust as needed.
# Individual services also read server/.env when run outside Docker (see server/.env.example).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=requirement_dashboard
POSTGRES_PORT=5434

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

API_PORT=4000
CLIENT_PORT=8081
CORS_ORIGIN=http://localhost:8081

# Server logging (passed into the server service). See docs/BACKEND-LOGGING.md
LOG_LEVEL=info
